# Variables de entorno — TerraVid Mobile
# Copiar este archivo a `.env` y completar los valores.
#
# El prefijo EXPO_PUBLIC_ es obligatorio: Expo solo expone al bundle las
# variables que empiezan así (ver src/config/env.ts).
#
# URL base del backend, sin barra final:
#   Emulador Android: http://10.0.2.2:3000/api
#   Simulador iOS y navegador: http://localhost:3000/api
#   Producción: https://terravid-api.duckdns.org/api (definitiva: terravid.com)
#
# Los builds de EAS (APK) no leen este archivo: la URL está en `env` de cada
# perfil de eas.json (M-012).
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000/api
